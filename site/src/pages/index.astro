---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CourseHome from '../components/CourseHome.astro';
import { courseStats } from '../data/course.mjs';

const description = `Пошаговый курс по Java Core из ${courseStats.lessons} уроков в ${courseStats.modules} модулях: реальные исходники из репозитория, упражнения и самопроверка.`;
---

<StarlightPage
  frontmatter={{
    title: 'Курс Java Core',
    description,
    template: 'splash'
  }}
  hasSidebar={false}
>
  <CourseHome />
</StarlightPage>
