---
import { Code } from 'astro-expressive-code/components';
import generated from '../data/generated.json';
import { basename } from '../utils/url.js';

const { file, focus = { full: true }, note, title, id } = Astro.props;
const entry = generated.files[file];

if (!entry) {
  throw new Error(`SourceCode: файл ${file} не найден в generated.json`);
}

function resolveRange(currentFocus) {
  if (currentFocus.full) return { start: 1, end: entry.lines };
  if (currentFocus.lines) {
    const [start, end] = currentFocus.lines;
    return { start, end };
  }
  if (currentFocus.method) {
    const candidates = entry.methods.filter(
      (method) =>
        method.name === currentFocus.method && (!currentFocus.match || method.signature.includes(currentFocus.match))
    );
    if (!candidates.length) {
      throw new Error(`SourceCode: метод ${currentFocus.method} не найден в ${file}`);
    }
    return { start: candidates[0].start, end: candidates[0].end };
  }
  if (currentFocus.symbol) {
    const type = entry.types.find((candidate) => candidate.name === currentFocus.symbol);
    if (!type) throw new Error(`SourceCode: тип ${currentFocus.symbol} не найден в ${file}`);
    return { start: type.start, end: type.end };
  }
  throw new Error(`SourceCode: неверный focus для ${file}`);
}

const { start, end } = resolveRange(focus);
const snippet = entry.code.split('\n').slice(start - 1, end).join('\n');
const displayTitle = title || `${basename(file)} · строки ${start}–${end}`;
---

<div class="source-block" id={id}>
  {note && <p class="source-note">{note}</p>}
  <Code code={snippet} lang="java" title={displayTitle} frame="code" showLineNumbers startLineNumber={start} wrap />
</div>
